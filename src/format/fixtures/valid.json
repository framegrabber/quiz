  "title": "Possessive determiners (Beispiel)",
  "subject": "Englisch",
  "grade": 5,
  "source": "Green Line 1 Bayern",
  "language": "en",
  "roundSize": 10,
  "categories": [
    { "id": "forms", "name": "my, your, his …" },
    { "id": "its", "name": "its oder it's" }
  ],
  "questions": [
    {
      "id": "pd-001",
      "type": "choice",
      "category": "its",
      "prompt": "The cat is playing with ___ ball.",
      "options": ["its", "it's", "his", "their"],
      "answer": "its",
      "explanation": "its = sein/ihr (Besitz). it's = it is."
    },
    {
      "id": "pd-002",
      "type": "choice",
      "category": "forms",
      "prompt": "Which words are possessive determiners?",
      "options": ["my", "me", "our", "us"],
      "answer": ["my", "our"]
    },
    {
      "id": "pd-003",
      "type": "input",
      "category": "forms",
      "prompt": "Tom and Lisa love ___ dog. (they)",
      "answer": "their"
    },
    {
      "id": "pd-004",
      "type": "cloze",
      "category": "forms",
      "prompt": "Ergänze die Begleiter.",
      "text": "I like {my} bike, but {her} bike is faster.",
      "distractors": ["his", "your"]
    },
    {
      "id": "pd-005",
      "type": "cloze",
      "category": "its",
      "text": "{Its|It's} hard to say. The dog wags {its} tail.",
      "mode": "type"
    }
  ]
